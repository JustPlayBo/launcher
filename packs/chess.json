{
  "schema": "boardgame/1.1",
  "id": "chess",
  "name": "Chess — open table",
  "bgg": 171,
  "description": "A checkerboard and the 12 chess pieces as unicode glyphs. No rules enforced — move freely.",
  "context": {
    "period": "Gupta India, c. 600 CE → the world",
    "blurb": "Chess descends from chaṭuraṅga, a 6th-century Indian game of four army divisions — infantry, cavalry, elephants and chariots — that became the pawn, knight, bishop and rook. It reached Persia as shīṅ (whence ‘check’), then Europe through the Islamic world, settling into the modern moves around 1475.",
    "links": [
      {
        "label": "Chess — Wikipedia",
        "url": "https://en.wikipedia.org/wiki/Chess"
      }
    ]
  },
  "rules": {
    "objective": "Checkmate the opposing king — attack it so that it cannot escape capture.",
    "players": "2",
    "duration": "10–60 min",
    "setup": "Each side starts with eight pawns on the second rank and the back rank set rook, knight, bishop, queen, king, bishop, knight, rook — the white queen on a light square. Use ‘Load sample layout’ to drop the opening position.",
    "howToPlay": [
      "White moves first; players then alternate, one piece per turn.",
      "Each piece moves its own way: rooks in straight lines, bishops diagonally, the queen both, knights in an L, the king one square, pawns forward (capturing diagonally).",
      "Capture by moving onto an enemy piece and removing it (drag it to the 🗑️)."
    ],
    "winning": "Checkmate ends the game. A position with no legal move and no check is stalemate — a draw.",
    "variants": [
      "Chess960 (Fischer random): shuffle the back rank.",
      "Blitz: agree a short time per side and use the turn indicator to keep pace."
    ]
  },
  "turns": {
    "players": [
      "White",
      "Black"
    ],
